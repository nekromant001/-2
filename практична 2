using System;
using System.Text;

class Program
{
    static void Main()
    { 
        Console.OutputEncoding = Encoding.UTF8;
        Console.InputEncoding = Encoding.UTF8;

        Console.Write("Введіть рік: ");

        if (int.TryParse(Console.ReadLine(), out int year))
        {
            bool isLeap = (year % 400 == 0) || (year % 4 == 0 && year % 100 != 0);

            Console.WriteLine(isLeap ? $"{year} - високосний рік" : $"{year} - НЕ високосний рік");
        }
        else
        {
            Console.WriteLine("Будь ласка, введіть коректне число.");
        }
    }
}




using System;
using System.Linq;
using System.Text;

class Program
{
    static void Main()
    {
        Console.OutputEncoding = Encoding.UTF8;
        Console.InputEncoding = Encoding.UTF8;

        Console.Write("Введіть висоту трикутника: ");
        if (int.TryParse(Console.ReadLine(), out int h))
        {
            int maxLength = string.Join(" ", Enumerable.Repeat(h, h)).Length;

            for (int i = 1; i <= h; i++)
            {
                string nums = string.Join(" ", Enumerable.Repeat(i, i));

                int padding = (maxLength - nums.Length) / 2;
                string spaces = new string(' ', padding);

                Console.WriteLine(spaces + nums);
            }
        }
    }
}





using System;
using System.Collections.Generic;
using System.Text;

class Question
{
    public string Text { get; set; }
    public string[] Options { get; set; }
    public string CorrectOption { get; set; }
}

class Program
{
    static void Main()
    {
        Console.OutputEncoding = Encoding.UTF8;
        Console.InputEncoding = Encoding.UTF8;

        var questions = new List<Question>
        {
            new Question { Text = "Яка компанія створила мову програмування C#?", Options = new[] { "1. Google", "2. Apple", "3. Microsoft", "4. Amazon" }, CorrectOption = "3" },
            new Question { Text = "Який тип даних у C# використовується для збереження логічних значень (True/False)?", Options = new[] { "1. int", "2. bool", "3. string", "4. float" }, CorrectOption = "2" },
            new Question { Text = "Як називається найпопулярніша система контролю версій коду?", Options = new[] { "1. Git", "2. SVN", "3. Mercurial", "4. Docker" }, CorrectOption = "1" },
            new Question { Text = "Яке з цих понять є одним із принципів об'єктно-орієнтованого програмування (ООП)?", Options = new[] { "1. Інкапсуляція", "2. Компіляція", "3. Рекурсія", "4. Дебагінг" }, CorrectOption = "1" },
            new Question { Text = "Які символи використовуються для написання однорядкового коментаря у C#?", Options = new[] { "1. <!--", "2. #", "3. //", "4. /*" }, CorrectOption = "3" }
        };

        int score = 0;
        Console.WriteLine($"Current User Score: {score}");

        for (int i = 0; i < questions.Count; i++)
        {
            Console.WriteLine($"Питання {i + 1}, {questions[i].Text}");
            foreach (var opt in questions[i].Options)
            {
                Console.WriteLine(opt);
            }

            Console.Write("Ваша відповідь: ");
            if (Console.ReadLine() == questions[i].CorrectOption)
            {
                Console.WriteLine("Correct answer");
                score += 100;
                Console.WriteLine($"Current User Score: {score}");
            }
            else
            {
                Console.WriteLine("Wrong Answer");
                break;
            }
        }
        Console.WriteLine("кінець програми.");
    }
}
